  "findings": [
    {
      "id": "R01",
      "priority": "P1",
      "claim_ids": [
        "prognosis_followup-4",
        "complications-4"
      ],
      "issue": "来源定位实际不存在，不能据此认定眼压、感染及新裂孔细节交叉核验。",
      "source_assessment": [
        "NEI Vitrectomy: What happens after vitrectomy?仅说检查视力和恢复、用滴药预防感染；未提供作者写出的pressure/infection/detachment风险清单。",
        "Moorfields After operation支持症状恶化联系医院，未说明每次复查固定检查的完整项目。"
      ],
      "required_change": "保留已有双源支持的术后恶化行动；为具体鉴别风险和复查清单增加实际原文及第二独立来源，或收窄到来源支持的范围。",
      "status": "open"
    },
    {
      "id": "R02",
      "priority": "P2",
      "claim_ids": [
        "diagnosis-4"
      ],
      "issue": "超声和OCT被合写成看不清眼底时均可使用，读者无法理解用途差异。",
      "source_assessment": [
        "原NEI总页只说两者帮助确认视网膜位置，不支持整句条件。",
        "独立新开ASRS Diagnostic testing paragraph 2区分：OCT看中心受累；看不清眼底时可用超声。"
      ],
      "required_change": "分开两项检查和用途；按新句重新绑定来源，保留检查选择由眼内情况决定。",
      "status": "open"
    },
    {
      "id": "R03",
      "priority": "P2",
      "claim_ids": [
        "treatment-1",
        "medications-1"
      ],
      "issue": "范围含牵拉性、渗出性，治疗和药物开头却统一围绕封闭破口、配合手术；渗出性机制并没有破口。",
      "source_assessment": [
        "NEI Types and causes的Exudative段说明液体积聚机制；其余主要治疗材料侧重裂孔及手术恢复。",
        "现有材料不构成所有脱离类型均可同一处理的完整支持。"
      ],
      "required_change": "明确本节哪些描述用于裂孔性或手术患者；对牵拉性/渗出性注明需要处理其基础原因并补充对应权威治疗证据。不得凭概览已提及就计入各子类型完整覆盖。",
      "status": "open"
    },
    {
      "id": "R04",
      "priority": "P2",
      "claim_ids": [
        "daily_care-4",
        "daily_care-gas-warning"
      ],
      "issue": "气体警示的核心正确，但跨来源配对不完整；Imperial原文独立访问失败。",
      "source_assessment": [
        "禁飞：NEI vitrectomy与Moorfields均支持；高海拔：NEI vitrectomy与RCOphth支持，但RCOphth未绑定daily_care-4。",
        "告知麻醉/避免笑气：Moorfields与RCOphth支持；NEI vitrectomy无麻醉披露段。",
        "气泡膨胀、眼压骤升机制本次仅在RCOphth重读确认；牙科只读到该文参考文献标题。"
      ],
      "required_change": "拆开飞行/高海拔、麻醉披露、笑气机制和情境；使用实际支持的两组材料。Imperial未能重开前不算本次独立确认；补查牙科原始资料或去掉尚未证实的特定情境。",
      "status": "open"
    },
    {
      "id": "R05",
      "priority": "P2",
      "claim_ids": [
        "summary-4",
        "causes_risks-4",
        "diagnosis-3",
        "differentials-2",
        "differentials-3",
        "treatment-2",
        "treatment-3",
        "treatment-4",
        "diet-2",
        "diet-3",
        "diet-4",
        "prognosis_followup-3",
